{
  "name": "dsh-quadrant-todos",
  "version": "1.0.0",
  "type": "module",
  "description": "Four-quadrant (Eisenhower) todo list with its own sidebar entry for the DeepSeek Harness Web UI.",
  "license": "MIT",
  "author": "zhengwenjie",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "todo",
    "eisenhower",
    "quadrant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nangongwentian-fe/dsh-quadrant-todos.git"
  },
  "homepage": "https://github.com/nangongwentian-fe/dsh-quadrant-todos#readme",
  "bugs": {
    "url": "https://github.com/nangongwentian-fe/dsh-quadrant-todos/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
